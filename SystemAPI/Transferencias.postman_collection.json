            "header": [
              {
                "key": "MessageIdentifier",
                "value": "{{$guid}}"
              },
              {
                "key": "DeviceIdentifier",
                "value": "postman-device"
              },
              {
                "key": "ChannelIdentifier",
                "value": "postman"
