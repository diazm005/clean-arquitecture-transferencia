{
  "info": {
    "name": "Transferencias API (BIAN)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "batchUrl",
      "value": "http://localhost:5210"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:5207"
    },
    {
      "key": "transactionReference",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "type": "string",
      "value": "",
      "key": "accessToken"
    }
  ],
  "item": [
    {
      "name": "Batchero HTTP (sin movimientos de dinero)",
      "item": [
        {
          "name": "Disponibilidad del batchero",
          "request": {
            "method": "GET",
            "url": "{{batchUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Batchero disponible', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().service).to.eql('FraudBatch'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Evaluación de riesgo alto por frecuencia",
          "request": {
            "method": "POST",
            "url": "{{batchUrl}}/api/fraud/evaluations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionReference\": \"{{transactionReference}}\",\n  \"amount\": 100,\n  \"previousDebitsIn15Minutes\": 5,\n  \"knownDestination\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cinco débitos previos bloquean por riesgo alto', () => { pm.response.to.have.status(200); const r = pm.response.json(); pm.expect(r.riskLevel).to.eql('Alto'); pm.expect(r.transactionReference).to.eql(pm.variables.get('transactionReference')); pm.expect(r.ruleVersion).to.eql('TALLER-1.0'); pm.expect(r.reason).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "RetrieveCustomer (200)",
          "request": {
