{
  "info": {
    "name": "Transferencias - SystemAPI + Fraude.Batch",
    "description": "Endpoints de SystemAPI (clean-arquitecture-transferencia, puerto 5207) y de Fraude.Batch (transferencias-api-antifraude, puerto 5310).\n\nEl token se genera solo con POST /api/dev/token para el DNI de la variable nationalId y se renueva al vencer. POST /api/transactions modifica datos en SQL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5207"
    },
    {
      "key": "batchUrl",
      "value": "http://127.0.0.1:5310"
    },
    {
      "key": "nationalId",
      "value": "12345678"
    },
    {
      "key": "accountNumber",
      "value": "001"
    },
    {
      "key": "transactionReference",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Se llena automáticamente."
    }
  ],
  "item": [
    {
      "name": "SystemAPI",
      "item": [
        {
          "name": "Token de desarrollo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/dev/token",
            "description": "Emite un token de 15 minutos. Solo responde desde localhost.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nationalId\": \"{{nationalId}}\",\n  \"readOnly\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Consultar cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "MessageIdentifier",
                "value": "{{$guid}}"
              },
              {
                "key": "DeviceIdentifier",
                "value": "postman-device"
              },
              {
                "key": "ChannelIdentifier",
                "value": "postman"
              }
            ],
            "url": "{{baseUrl}}/api/client/{{nationalId}}",
            "description": "Requiere transferencias.read. Solo el cliente del token."
          }
        },
        {
          "name": "Consultar cuenta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "MessageIdentifier",
                "value": "{{$guid}}"
              },
              {
                "key": "DeviceIdentifier",
                "value": "postman-device"
              },
              {
                "key": "ChannelIdentifier",
                "value": "postman"
              }
            ],
            "url": "{{baseUrl}}/api/account/{{accountNumber}}",
            "description": "Requiere transferencias.read. Solo cuentas propias."
          }
        },
        {
          "name": "Realizar transferencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "MessageIdentifier",
                "value": "{{$guid}}"
              },
              {
                "key": "DeviceIdentifier",
                "value": "postman-device"
              },
              {
                "key": "ChannelIdentifier",
                "value": "postman"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/transactions",
            "description": "Requiere transferencias.write. Evalúa el riesgo con Fraude.Batch antes de debitar. Para confirmar con OTP, reenvía la misma referencia con otpCode 123456.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionReference\": \"{{transactionReference}}\",\n  \"customerNationalId\": \"{{nationalId}}\",\n  \"sourceAccountNumber\": \"{{accountNumber}}\",\n  \"destinationAccountNumber\": \"EXTERNA\",\n  \"destinationBank\": \"BANCO_B\",\n  \"amount\": 100,\n  \"otpCode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('transactionReference', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar transferencia",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "MessageIdentifier",
                "value": "{{$guid}}"
              },
              {
                "key": "DeviceIdentifier",
                "value": "postman-device"
              },
              {
                "key": "ChannelIdentifier",
                "value": "postman"
              }
            ],
            "url": "{{baseUrl}}/api/transactions/{{transactionReference}}",
            "description": "Requiere transferencias.read. Usa la referencia de la última transferencia."
          }
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ping",
            "description": "Público.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Disponibilidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live",
            "description": "Público.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Fraude.Batch",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Disponibilidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{batchUrl}}/health",
            "description": "Estado y versión de regla."
          }
        },
        {
          "name": "Evaluar riesgo (score)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{batchUrl}}/api/fraud/evaluations",
            "description": "Devuelve riskLevel (Bajo/Medio/Alto), reason y ruleVersion. No usa SQL ni JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionReference\": \"{{transactionReference}}\",\n  \"amount\": 100,\n  \"previousDebitsIn15Minutes\": 0,\n  \"knownDestination\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('transactionReference', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera el token automáticamente con el emisor local de la API (solo Development, solo localhost).",
          "if (pm.request.auth && pm.request.auth.type === 'noauth') return;",
          "const expires = Number(pm.collectionVariables.get('accessTokenExpires') || 0);",
          "if (pm.collectionVariables.get('accessToken') && Date.now() < expires - 30000) return;",
          "pm.sendRequest({",
          "  url: pm.collectionVariables.get('baseUrl') + '/api/dev/token', method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ nationalId: pm.collectionVariables.get('nationalId') }) }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.warn('No se pudo generar el token', err || res.code); return; }",
          "  const r = res.json();",
          "  pm.collectionVariables.set('accessToken', r.accessToken);",
          "  pm.collectionVariables.set('accessTokenExpires', String(Date.now() + r.expiresIn * 1000));",
          "});"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}